{
    "name": "justinholtweb/craft-vismaz",
    "description": "Visma eAccounting integration for Craft Commerce — post orders as invoices or summary vouchers, with Swedish VAT, reverse charge, OSS and SIE 4 export.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "visma",
        "eaccounting",
        "eekonomi",
        "spiris",
        "accounting",
        "bokforing",
        "sie",
        "sweden",
        "moms",
        "vat"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-iconv": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\vismaz\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Vismaz",
        "handle": "vismaz",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-vismaz/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-vismaz/main/CHANGELOG.md",
        "class": "justinholtweb\\vismaz\\Plugin"
    }
}
