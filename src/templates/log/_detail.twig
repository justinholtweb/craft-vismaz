{% extends "_layouts/cp" %}

{% set title = 'Log entry'|t('vismaz') ~ ' #' ~ entry.id %}
{% set selectedSubnavItem = 'log' %}
{% set crumbs = [{ label: 'Log'|t('vismaz'), url: url('vismaz/log') }] %}

{% block content %}
    <div class="meta read-only">
        {% for label, value in {
            ('When'|t('vismaz')): entry.dateCreated,
            ('Action'|t('vismaz')): entry.action,
            ('Level'|t('vismaz')): entry.level,
            ('Method'|t('vismaz')): entry.method ?: '—',
            ('Status'|t('vismaz')): entry.statusCode ?: '—',
            ('Duration'|t('vismaz')): entry.durationMs ? entry.durationMs ~ ' ms' : '—'
        } %}
            <div class="data">
                <div class="heading">{{ label }}</div>
                <div class="value">{{ value }}</div>
            </div>
        {% endfor %}

        {% if entry.url %}
            <div class="data">
                <div class="heading">{{ 'URL'|t('vismaz') }}</div>
                <div class="value"><code>{{ entry.url }}</code></div>
            </div>
        {% endif %}

        {% if entry.orderId %}
            <div class="data">
                <div class="heading">{{ 'Order'|t('vismaz') }}</div>
                <div class="value"><a href="{{ cpUrl('commerce/orders/' ~ entry.orderId) }}">#{{ entry.orderId }}</a></div>
            </div>
        {% endif %}

        {% if entry.documentId %}
            <div class="data">
                <div class="heading">{{ 'Document'|t('vismaz') }}</div>
                <div class="value"><a href="{{ url('vismaz/documents/' ~ entry.documentId) }}">#{{ entry.documentId }}</a></div>
            </div>
        {% endif %}
    </div>

    {% if entry.message %}
        <blockquote class="note {{ entry.level == 'error' ? 'error' : (entry.level == 'warning' ? 'warning' : '') }}" style="margin-top:16px;">
            <p>{{ entry.message }}</p>
        </blockquote>
    {% endif %}

    {% if entry.orderId and entry.action starts with 'payment.' and currentUser.can('vismaz-pushDocuments') %}
        <form method="post" accept-charset="UTF-8" style="margin-top:16px;">
            {{ csrfInput() }}
            {{ actionInput('vismaz/payments/register') }}
            {{ redirectInput('vismaz/log/' ~ entry.id) }}
            {{ hiddenInput('orderId', entry.orderId) }}
            <button type="submit" class="btn submit">{{ 'Register this order’s payments again'|t('vismaz') }}</button>
            <span class="light" style="margin-left:8px;">{{ 'Payments already in Visma are skipped, never sent twice.'|t('vismaz') }}</span>
        </form>
    {% endif %}

    {% for label, body in { ('Request'|t('vismaz')): entry.requestBody, ('Response'|t('vismaz')): entry.responseBody } %}
        {% if body %}
            <h2 style="margin-top:24px;">{{ label }}</h2>
            <pre style="max-height:400px;overflow:auto;background:#f7f7f9;padding:10px;border-radius:4px;"><code>{{ body }}</code></pre>
        {% endif %}
    {% endfor %}
{% endblock %}
