{% import "_includes/forms" as forms %}
{% from "_includes/forms" import textField, lightswitchField, selectField, autosuggestField %}

{% set plugin = plugin ?? craft.app.plugins.getPlugin('vismaz') %}
{% set auth = plugin.auth %}
{% set connection = auth.getConnection() %}
{% set basLabels = {
    '3001': 'Försäljning varor inom Sverige, 25 % moms',
    '3002': 'Försäljning varor inom Sverige, 12 % moms',
    '3003': 'Försäljning varor inom Sverige, 6 % moms',
    '3004': 'Försäljning varor inom Sverige, momsfri',
    '2610': 'Utgående moms, 25 %',
    '2620': 'Utgående moms, 12 %',
    '2630': 'Utgående moms, 6 %'
} %}

{% if not craft.app.plugins.isPluginEnabled('commerce') %}
    <div class="readable">
        <blockquote class="note warning">
            <p>{{ 'Vismaz needs Craft Commerce, which is not installed or is disabled.'|t('vismaz') }}</p>
        </blockquote>
    </div>
{% endif %}

<h2>{{ 'Connection'|t('vismaz') }}</h2>

<div class="readable">
    <p>
        {{ 'Vismaz connects to Visma eAccounting — sold in Sweden as Bokföring & Fakturering, previously eEkonomi. Create an app in the Visma developer portal, then paste its credentials here and connect.'|t('vismaz') }}
    </p>
</div>

{{ selectField({
    label: 'Environment'|t('vismaz'),
    instructions: 'Sandbox and production are entirely separate hosts, credentials and companies. Each keeps its own connection, so switching back and forth does not lose either.'|t('vismaz'),
    id: 'environment',
    name: 'environment',
    value: settings.environment,
    options: {
        sandbox: 'Sandbox'|t('vismaz'),
        production: 'Production'|t('vismaz')
    },
    errors: settings.getErrors('environment')
}) }}

{{ autosuggestField({
    label: 'Client ID'|t('vismaz'),
    id: 'clientId',
    name: 'clientId',
    value: settings.clientId,
    suggestEnvVars: true,
    errors: settings.getErrors('clientId')
}) }}

{{ autosuggestField({
    label: 'Client secret'|t('vismaz'),
    id: 'clientSecret',
    name: 'clientSecret',
    value: settings.clientSecret,
    suggestEnvVars: true,
    errors: settings.getErrors('clientSecret')
}) }}

{% include 'vismaz/_connection' %}

<hr>

<h2>{{ 'What gets posted'|t('vismaz') }}</h2>

{{ selectField({
    label: 'Document mode'|t('vismaz'),
    instructions: 'An invoice per order suits a B2B shop and makes Visma’s own reminders work. A summary voucher suits a busy consumer shop: 900 orders a day become one verification instead of 900 invoices in the customer ledger.'|t('vismaz'),
    id: 'documentMode',
    name: 'documentMode',
    value: settings.documentMode,
    options: {
        invoice: 'Customer invoice per order'|t('vismaz'),
        voucher: 'Periodic summary voucher'|t('vismaz')
    },
    errors: settings.getErrors('documentMode')
}) }}

{{ selectField({
    label: 'Aggregation period'|t('vismaz'),
    id: 'voucherPeriod',
    name: 'voucherPeriod',
    value: settings.voucherPeriod,
    options: {
        daily: 'Daily'|t('vismaz'),
        weekly: 'Weekly'|t('vismaz'),
        monthly: 'Monthly'|t('vismaz')
    }
}) }}

{{ textField({
    label: 'Voucher series'|t('vismaz'),
    id: 'voucherSeries',
    name: 'voucherSeries',
    value: settings.voucherSeries,
    size: 4,
    errors: settings.getErrors('voucherSeries')
}) }}

{{ lightswitchField({
    label: 'Send automatically when an order completes'|t('vismaz'),
    instructions: 'Queued, never inline: a Visma outage must not be able to stop a customer paying.'|t('vismaz'),
    id: 'autoPush',
    name: 'autoPush',
    on: settings.autoPush
}) }}

{{ lightswitchField({
    label: 'Create credit notes for refunds'|t('vismaz'),
    id: 'syncRefunds',
    name: 'syncRefunds',
    on: settings.syncRefunds
}) }}

{% set statusOptions = [] %}
{% if craft.app.plugins.isPluginEnabled('commerce') %}
    {% for status in craft.commerce.orderStatuses.getAllOrderStatuses() %}
        {% set statusOptions = statusOptions|merge([{ label: status.name, value: status.handle }]) %}
    {% endfor %}
{% endif %}

{{ forms.checkboxSelectField({
    label: 'Only sync these order statuses'|t('vismaz'),
    instructions: 'Leave everything unchecked to sync every completed order.'|t('vismaz'),
    id: 'syncStatusHandles',
    name: 'syncStatusHandles',
    options: statusOptions,
    values: settings.syncStatusHandles,
    showAllOption: false
}) }}

{{ textField({
    label: 'Payment terms (days)'|t('vismaz'),
    id: 'paymentTermsDays',
    name: 'paymentTermsDays',
    value: settings.paymentTermsDays,
    size: 5,
    type: 'number',
    errors: settings.getErrors('paymentTermsDays')
}) }}

<hr>

<h2>{{ 'Customers and articles'|t('vismaz') }}</h2>

{{ lightswitchField({
    label: 'Create a Visma customer per buyer'|t('vismaz'),
    id: 'syncCustomers',
    name: 'syncCustomers',
    on: settings.syncCustomers
}) }}

{{ lightswitchField({
    label: 'Use one shared webshop customer instead'|t('vismaz'),
    instructions: 'For a consumer shop this is usually the right answer. A Visma customer register holding forty thousand one-time buyers is not a customer register.'|t('vismaz'),
    id: 'useAggregateCustomer',
    name: 'useAggregateCustomer',
    on: settings.useAggregateCustomer
}) }}

{{ textField({
    label: 'Shared customer number'|t('vismaz'),
    instructions: 'Vismaz reuses this customer if it already exists in Visma, and creates it once if it does not.'|t('vismaz'),
    id: 'aggregateCustomerNumber',
    name: 'aggregateCustomerNumber',
    value: settings.aggregateCustomerNumber,
    size: 12
}) }}

{{ lightswitchField({
    label: 'Create a Visma article per SKU'|t('vismaz'),
    instructions: 'Turns on Visma’s own sales-per-article reporting. Leave off for a large catalogue — invoices then use free-text rows, which is equally valid bookkeeping.'|t('vismaz'),
    id: 'syncArticles',
    name: 'syncArticles',
    on: settings.syncArticles
}) }}

{{ textField({
    label: 'Organisation number field handle'|t('vismaz'),
    instructions: 'Handle of the custom field on Craft addresses holding a Swedish organisationsnummer.'|t('vismaz'),
    id: 'organisationNumberFieldHandle',
    name: 'organisationNumberFieldHandle',
    value: settings.organisationNumberFieldHandle
}) }}

{{ textField({
    label: 'VAT number field handle'|t('vismaz'),
    instructions: 'Handle of the address field holding an EU VAT number. Without this, reverse charge can never apply — Vismaz has nothing to read.'|t('vismaz'),
    id: 'vatNumberFieldHandle',
    name: 'vatNumberFieldHandle',
    value: settings.vatNumberFieldHandle
}) }}

<hr>

<h2>{{ 'Swedish VAT'|t('vismaz') }}</h2>

{{ textField({
    label: 'Home country'|t('vismaz'),
    instructions: 'Two-letter code. Every other destination is judged relative to this one.'|t('vismaz'),
    id: 'homeCountry',
    name: 'homeCountry',
    value: settings.homeCountry,
    size: 4,
    errors: settings.getErrors('homeCountry')
}) }}

{{ lightswitchField({
    label: 'Settle totals to whole kronor (öresavrundning)'|t('vismaz'),
    instructions: 'The difference is posted to the rounding account below, as a real line — not absorbed into the last price.'|t('vismaz'),
    id: 'roundToWholeKronor',
    name: 'roundToWholeKronor',
    on: settings.roundToWholeKronor
}) }}

{{ lightswitchField({
    label: 'Apply reverse charge to EU business sales'|t('vismaz'),
    instructions: 'Omvänd betalningsskyldighet: a sale to another EU country against a valid VAT number is zero-rated, and the invoice says so.'|t('vismaz'),
    id: 'reverseChargeEnabled',
    name: 'reverseChargeEnabled',
    on: settings.reverseChargeEnabled
}) }}

{{ lightswitchField({
    label: 'Validate VAT numbers against VIES'|t('vismaz'),
    instructions: 'Strongly recommended. When VIES cannot be reached the sale stays taxed — zero-rating on the strength of a timeout is the merchant’s liability, not the buyer’s.'|t('vismaz'),
    id: 'validateVatNumbers',
    name: 'validateVatNumbers',
    on: settings.validateVatNumbers
}) }}

{{ textField({
    label: 'Reverse charge note'|t('vismaz'),
    instructions: 'Printed on the invoice. Swedish law wants the invoice to say so; the buyer’s own tax authority wants it in a language they read.'|t('vismaz'),
    id: 'reverseChargeNote',
    name: 'reverseChargeNote',
    value: settings.reverseChargeNote
}) }}

{{ lightswitchField({
    label: 'Apply destination VAT to EU consumer sales (OSS)'|t('vismaz'),
    instructions: 'Turn on once you are registered for One Stop Shop. The OSS report then breaks the quarter down by country and rate for you.'|t('vismaz'),
    id: 'ossEnabled',
    name: 'ossEnabled',
    on: settings.ossEnabled
}) }}

<hr>

<h2>{{ 'Ledger accounts'|t('vismaz') }}</h2>

<div class="readable">
    <p>
        {{ 'BAS defaults, which most Swedish shops can leave alone. They matter for summary vouchers and SIE files; invoice mode takes its accounts from Visma’s own article coding.'|t('vismaz') }}
    </p>
</div>

{% for rate, label in { '25': '25 %', '12': '12 %', '6': '6 %', '0': 'momsfri' } %}
    {{ textField({
        label: 'Sales, {rate}'|t('vismaz', { rate: label }),
        instructions: basLabels[settings.salesAccounts[rate] ?? ''] ?? null,
        id: 'salesAccounts-' ~ rate,
        name: 'salesAccounts[' ~ rate ~ ']',
        value: settings.salesAccounts[rate] ?? '',
        size: 6
    }) }}
{% endfor %}

{% for rate, label in { '25': '25 %', '12': '12 %', '6': '6 %' } %}
    {{ textField({
        label: 'Output VAT, {rate}'|t('vismaz', { rate: label }),
        instructions: basLabels[settings.vatAccounts[rate] ?? ''] ?? null,
        id: 'vatAccounts-' ~ rate,
        name: 'vatAccounts[' ~ rate ~ ']',
        value: settings.vatAccounts[rate] ?? '',
        size: 6
    }) }}
{% endfor %}

{% for field in [
    { handle: 'goodsEuExemptAccount', label: 'Goods to another EU country, exempt'|t('vismaz') },
    { handle: 'goodsNonEuAccount', label: 'Goods outside the EU'|t('vismaz') },
    { handle: 'servicesEuAccount', label: 'Services to another EU country'|t('vismaz') },
    { handle: 'servicesNonEuAccount', label: 'Services outside the EU'|t('vismaz') },
    { handle: 'freightAccount', label: 'Invoiced freight'|t('vismaz') },
    { handle: 'discountAccount', label: 'Discounts given'|t('vismaz') },
    { handle: 'roundingAccount', label: 'Öresavrundning'|t('vismaz') },
    { handle: 'receivablesAccount', label: 'Accounts receivable'|t('vismaz') },
    { handle: 'defaultPaymentAccount', label: 'Default settlement account'|t('vismaz') },
    { handle: 'feeAccount', label: 'Payment fees'|t('vismaz') }
] %}
    {{ textField({
        label: field.label,
        instructions: craft.vismaz.accountLabel(attribute(settings, field.handle) ?? ''),
        id: field.handle,
        name: field.handle,
        value: attribute(settings, field.handle),
        size: 6,
        errors: settings.getErrors(field.handle)
    }) }}
{% endfor %}

{% set gatewayRows = [] %}
{% if craft.app.plugins.isPluginEnabled('commerce') %}
    {% for gateway in craft.commerce.gateways.getAllGateways() %}
        {% set mapped = settings.paymentAccounts[gateway.handle] ?? {} %}
        {% set gatewayRows = gatewayRows|merge([{
            gateway: gateway.handle,
            account: mapped.account ?? '',
            feeAccount: mapped.feeAccount ?? '',
            feePercent: mapped.feePercent ?? '',
            feeFixed: mapped.feeFixed ?? ''
        }]) %}
    {% endfor %}
{% endif %}

{{ forms.editableTableField({
    label: 'Payment method accounts'|t('vismaz'),
    instructions: 'Klarna, Swish, card and invoice do not settle to the same account, and the processor’s cut is a cost posting of its own. This is the setting that decides whether the books reconcile against the payment statements.'|t('vismaz'),
    id: 'paymentAccounts',
    name: 'paymentAccounts',
    cols: {
        gateway: { heading: 'Gateway'|t('vismaz'), type: 'singleline', width: '25%' },
        account: { heading: 'Settles to'|t('vismaz'), type: 'singleline', width: '15%' },
        feeAccount: { heading: 'Fee account'|t('vismaz'), type: 'singleline', width: '15%' },
        feePercent: { heading: 'Fee %'|t('vismaz'), type: 'singleline', width: '15%' },
        feeFixed: { heading: 'Fee fixed'|t('vismaz'), type: 'singleline', width: '15%' }
    },
    rows: gatewayRows,
    addRowLabel: 'Add a gateway'|t('vismaz'),
    static: false
}) }}

<hr>

<h2>{{ 'Log'|t('vismaz') }}</h2>

{{ lightswitchField({
    label: 'Record request and response bodies'|t('vismaz'),
    instructions: 'Credentials and tokens are stripped before anything is stored.'|t('vismaz'),
    id: 'logPayloads',
    name: 'logPayloads',
    on: settings.logPayloads
}) }}

{{ textField({
    label: 'Keep log entries for (days)'|t('vismaz'),
    instructions: '0 keeps everything.'|t('vismaz'),
    id: 'logRetentionDays',
    name: 'logRetentionDays',
    value: settings.logRetentionDays,
    size: 5,
    type: 'number',
    errors: settings.getErrors('logRetentionDays')
}) }}
